// ============================================================================
// Nexus Talent System — schéma Prisma
// Dérivé fidèlement de src/types.ts + server.ts (modèle de données existant).
// Phase 1 : SCHÉMA UNIQUEMENT. À valider avant `prisma migrate dev`.
//
// Décisions actées :
//  - Multi-tenant : toutes les entités métier référencent Company (companyId), relation obligatoire.
//  - Compétences normalisées (référentiel Skill partagé candidats ↔ offres) pour le matching IA.
//  - Scores en table 1-1 (CandidateScore) pour évoluer sans toucher à Candidate.
//  - analysis / recommendation en Json (affichés en bloc, non filtrés transversalement).
//  - SkillCategory portée par Skill (nature intrinsèque).
//  - JobSkill porte `weight` (matching pondéré) + `required`.
// ============================================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============================================================================
// ENUMS  (valeurs = celles de src/types.ts, à l'identique)
// ============================================================================

enum UserRole {
  AdminPlateforme
  AdminEntreprise
  RH
  Manager
  ConsultantRecrutement
}

enum ContractType {
  CDI
  CDD
  Freelance
  Alternance
  Stage
}

enum JobStatus {
  Active
  Archived
  Draft
}

enum PipelineStage {
  Received
  Analyzed
  Preselected
  HRInterview
  TechTest
  FinalInterview
  OfferSent
  Hired
  Rejected
}

enum EmailStatus {
  Pending
  Imported
  Ignored
}

enum SkillCategory {
  Language
  Framework
  Database
  Tool
  Cloud
  SoftSkill
  Domain        // compétence métier / sectorielle (comptabilité, fiscalité, RH, juridique…)
  Certification // certification / habilitation (DSCG, CACES, AWS Certified…)
}

// ============================================================================
// TENANT
// ============================================================================

model Company {
  id        String   @id @default(uuid())
  name      String
  domain    String
  logoUrl   String?
  appName   String?  @default("Nexus Talent") // nom de l'app affiché (personnalisable)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  users      User[]
  jobs       Job[]
  candidates Candidate[]
  emails     Email[]
  auditLogs  AuditLog[]
  interviews Interview[]

  @@index([domain])
}

model User {
  id           String   @id @default(uuid())
  companyId    String
  name         String
  email        String   @unique
  role         UserRole
  avatarUrl    String?
  passwordHash String
  // Réinitialisation de mot de passe : on ne stocke QUE le hash SHA-256 du token
  // (jamais le token en clair) + son expiration. Effacés après usage.
  resetTokenHash   String?
  resetTokenExpiry DateTime?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  company   Company    @relation(fields: [companyId], references: [id], onDelete: Cascade)
  auditLogs AuditLog[]

  @@index([companyId])
}

// ============================================================================
// JOBS
// ============================================================================

model Job {
  id                 String       @id @default(uuid())
  companyId          String
  title              String
  description        String
  missions           String[] // texte libre — reste tableau
  educationRequired  String
  languagesRequired  String[] // ex. "Anglais (Technique)" — texte libre, PAS des Skill
  softSkillsRequired String[] // savoir-être souhaités (soft skills) — texte libre
  minExperienceYears Int
  salaryRange        String?
  deadline           DateTime? // date limite de candidature (optionnelle)
  location           String
  contractType       ContractType
  status             JobStatus    @default(Draft)
  priority           String?      @default("Normal") // "Urgent", "Haute", "Normal", "Basse"
  domain             String?      @default("IT") // "IT" | "Autre" — pilote la grille de compétences de l'analyse IA
  createdAt          DateTime     @default(now())
  updatedAt          DateTime     @updatedAt

  company    Company     @relation(fields: [companyId], references: [id], onDelete: Cascade)
  candidates Candidate[]
  skills     JobSkill[] // skillsRequired[] normalisé via le référentiel Skill

  @@index([companyId])
  @@index([status])
}

// ============================================================================
// CANDIDATS
// ============================================================================

model Candidate {
  id          String        @id @default(uuid())
  companyId   String
  jobId       String? // optionnel : vivier de talents / candidature spontanée / import massif
  name        String
  // Pas de @@unique([companyId, email]) en MVP : jobId étant optionnel, un même
  // candidat peut légitimement exister plusieurs fois (vivier + candidatures).
  // Évolution identifiée : séparer Candidate (personne) et Application (candidature)
  // le jour où une fiche-personne unique par tenant devient un besoin produit.
  email       String
  phone       String
  location    String
  linkedinUrl String?
  avatarUrl   String? // photo de profil (URL), optionnelle
  stage       PipelineStage @default(Received)
  cvText      String?
  letterText  String?
  // Années d'expérience dénormalisées (miroir de analysis.yearsOfExperience) dans
  // une vraie colonne indexée → agrégations/filtres en SQL sans charger tout le JSON.
  // Renseignée à l'analyse IA ; backfill des lignes existantes via script dédié.
  experienceYears   Int?
  salaryExpectation String? // prétention salariale (extraite de la lettre ou saisie manuellement)
  source      String? // canal de sourcing : "LinkedIn", "Indeed", "/postuler", "Email", "Manuel"…
  appliedAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  // Blocs affichés en bloc, non filtrés transversalement → JSON
  analysis       Json?
  recommendation Json?

  company Company          @relation(fields: [companyId], references: [id], onDelete: Cascade)
  job     Job?             @relation(fields: [jobId], references: [id], onDelete: SetNull)
  score   CandidateScore? // 1-1, créé après analyse IA
  skills  CandidateSkill[]
  interviews Interview[]

  @@index([companyId])
  @@index([jobId])
  @@index([stage])
  @@index([experienceYears])
}

// Entretien planifié pour un candidat (événement structuré, visible dans
// l'historique de la fiche et dans la vue Calendrier).
model Interview {
  id          String   @id @default(cuid())
  companyId   String
  candidateId String
  jobId       String?
  date        String // "YYYY-MM-DD"
  time        String // "HH:MM"
  type        String // "RH" | "Technique" | "Final"
  notes       String?
  createdAt   DateTime @default(now())
  createdBy   String?

  company   Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)
  candidate Candidate @relation(fields: [candidateId], references: [id], onDelete: Cascade)

  @@index([companyId])
  @@index([candidateId])
}

model CandidateScore {
  candidateId     String   @id
  skillsScore     Float
  experienceScore Float
  educationScore  Float
  softSkillsScore Float
  languagesScore  Float
  globalScore     Float
  updatedAt       DateTime @updatedAt

  candidate Candidate @relation(fields: [candidateId], references: [id], onDelete: Cascade)

  @@index([globalScore])
}

// ============================================================================
// RÉFÉRENTIEL COMPÉTENCES (partagé candidats ↔ offres)
// ============================================================================

model Skill {
  id        String        @id @default(uuid())
  name      String        @unique
  category  SkillCategory
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt

  candidates CandidateSkill[]
  jobs       JobSkill[]
}

model CandidateSkill {
  candidateId String
  skillId     String

  candidate Candidate @relation(fields: [candidateId], references: [id], onDelete: Cascade)
  skill     Skill     @relation(fields: [skillId], references: [id], onDelete: Cascade)

  @@id([candidateId, skillId])
  @@index([skillId])
}

model JobSkill {
  jobId    String
  skillId  String
  required Boolean @default(true)
  weight   Int? // pondération pour le matching (ex. React 40, Docker 10)

  job   Job   @relation(fields: [jobId], references: [id], onDelete: Cascade)
  skill Skill @relation(fields: [skillId], references: [id], onDelete: Cascade)

  @@id([jobId, skillId])
  @@index([skillId])
}

// ============================================================================
// MÉTIER
// ============================================================================

model Email {
  id                String      @id @default(uuid())
  companyId         String
  from              String
  subject           String
  body              String
  date              DateTime
  attachmentName    String?
  attachmentContent String?
  status            EmailStatus @default(Pending)
  updatedAt         DateTime    @updatedAt

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@index([companyId])
  @@index([status])
}

// ============================================================================
// PERMISSIONS (matrice rôle × action, GLOBALE à la plateforme)
// ============================================================================
// Grille "Rôles & permissions" éditable depuis Paramètres (Super admin / Admin).
// Une ligne = un droit (action) accordé ou non à un rôle. GLOBALE : pas de
// companyId → une seule grille partagée par tous les tenants (choix produit).
// L'absence de ligne pour un couple (action, role) = repli sur le défaut codé.
model RolePermission {
  action    String // clé stable d'action (ex. "manage_users") — voir PERMISSION_ACTIONS (server.ts)
  role      UserRole
  allowed   Boolean  @default(false)
  updatedAt DateTime @updatedAt

  @@id([action, role])
}

model AuditLog {
  id        String   @id @default(uuid())
  companyId String
  userId    String? // nullable : le log survit à la suppression de l'utilisateur
  userName  String // dénormalisé : reste lisible même si l'user est supprimé
  userRole  UserRole
  action    String
  details   String
  ip        String? // adresse IP du client (connexions) — proxy Render/Cloudflare géré
  userAgent String? // navigateur / appareil (connexions)
  timestamp DateTime @default(now())

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  user    User?   @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([companyId])
  @@index([userId])
}
