# =============================================================================
# Nexus Talent System — variables d'environnement
# Copiez ce fichier en `.env` (jamais versionné) et renseignez vos valeurs.
# =============================================================================

# Connexion PostgreSQL (base "nexus" locale par défaut).
# Format : postgresql://UTILISATEUR:MOT_DE_PASSE@HOTE:PORT/BASE?schema=public
DATABASE_URL="postgresql://postgres:MOT_DE_PASSE@localhost:5432/nexus?schema=public"

# Clé API Google Gemini (analyse de CV, recherche sémantique).
# À générer sur https://aistudio.google.com/apikey
# (nouveau format 2026 : la clé commence par "AQ.").
GEMINI_API_KEY="AQ.votre_cle_gemini"

# Secrets JWT (authentification). Optionnels en dev (des valeurs par défaut sont
# utilisées si absents), mais À DÉFINIR avec des chaînes aléatoires pour tout
# usage réel.
JWT_ACCESS_SECRET="changez-moi-chaine-aleatoire"
JWT_REFRESH_SECRET="changez-moi-autre-chaine-aleatoire"
