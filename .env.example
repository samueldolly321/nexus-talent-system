# =============================================================================
# Nexus Talent System — variables d'environnement
# Copiez ce fichier en `.env` (jamais versionné) et renseignez vos valeurs.
# =============================================================================

# Connexion PostgreSQL (base "nexus" locale par défaut).
# Format : postgresql://UTILISATEUR:MOT_DE_PASSE@HOTE:PORT/BASE?schema=public
DATABASE_URL="postgresql://postgres:MOT_DE_PASSE@localhost:5432/nexus?schema=public"

# Clé API Google Gemini (analyse de CV, recherche sémantique).
# À générer sur https://aistudio.google.com/apikey
# (nouveau format 2026 : la clé commence par "AQ.").
GEMINI_API_KEY="AQ.votre_cle_gemini"

# Secrets JWT (authentification). Optionnels en dev (des valeurs par défaut sont
# utilisées si absents), mais À DÉFINIR avec des chaînes aléatoires pour tout
# usage réel.
JWT_ACCESS_SECRET="changez-moi-chaine-aleatoire"
JWT_REFRESH_SECRET="changez-moi-autre-chaine-aleatoire"

# Envoi d'emails transactionnels via Resend (partage pipeline/profil,
# confirmation de candidature, notification recruteur). Si la clé est absente,
# l'envoi est silencieusement désactivé (l'app fonctionne sans).
# Clé à générer sur https://resend.com/api-keys
RESEND_API_KEY=your_resend_api_key
# Adresse expéditeur. "onboarding@resend.dev" fonctionne sans domaine vérifié
# (tests) ; en production, utilisez une adresse de votre domaine vérifié.
EMAIL_FROM="onboarding@resend.dev"

# Origine autorisée par CORS (protection production). En dev, laissez vide
# (localhost:3000 / 5173 autorisés par défaut) ; en prod, mettez votre domaine.
# Sert AUSSI de base aux redirections OAuth et aux liens de réinitialisation
# (sans elle : http://localhost:3000).
FRONTEND_URL=https://ton-domaine.com

# -----------------------------------------------------------------------------
# Connexion Google (OAuth 2.0 / OIDC). OPTIONNEL : sans ces valeurs, le bouton
# "Google" reste désactivé sur l'écran de connexion.
# 1. Créez des identifiants OAuth sur https://console.cloud.google.com/apis/credentials
# 2. Type "Application Web" ; URI de redirection autorisée :
#    <FRONTEND_URL>/api/auth/google/callback  (dev : http://localhost:3000/api/auth/google/callback)
# NB : la connexion ne réussit que si l'email Google correspond à un utilisateur
# déjà créé dans l'application (liaison de compte, pas d'auto-inscription).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# -----------------------------------------------------------------------------
# SSO d'entreprise (OpenID Connect générique : Okta, Azure AD, Auth0, Keycloak…).
# OPTIONNEL : sans ces valeurs, le bouton "SSO" reste désactivé.
# SSO_ISSUER = URL de base du fournisseur (le serveur lit .well-known/openid-configuration).
# URI de redirection à déclarer chez le fournisseur :
#    <FRONTEND_URL>/api/auth/sso/callback  (dev : http://localhost:3000/api/auth/sso/callback)
# Même règle de liaison de compte que Google (l'email doit exister dans l'app).
SSO_ISSUER=
SSO_CLIENT_ID=
SSO_CLIENT_SECRET=
